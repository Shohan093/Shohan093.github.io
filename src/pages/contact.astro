
---
import BaseLayout from "../layouts/BaseLayout.astro";

const contactEmail = "anisujjamanshohan093@gmail.com";

const academicProfiles = [
  {
    name: "LinkedIn",
    description: "Professional networking and career profile",
    url: "https://www.linkedin.com/in/anisujjaman-shohan/",
    icon: "in",
  },
  {
    name: "ResearchGate",
    description: "Research profile and scholarly work",
    url: "https://www.researchgate.net/profile/Md-Anisujjaman",
    icon: "RG",
  },
  {
    name: "ORCID",
    description: "Researcher identifier and scholarly record",
    url: "https://orcid.org/0009-0001-0651-5748",
    icon: "iD",
  },
];

const technicalProfiles = [
  {
    name: "GitHub",
    description: "Code repositories and technical projects",
    url: "https://github.com/Shohan093",
    icon: "GH",
  },
  {
    name: "Kaggle",
    description: "Data science and machine learning",
    url: "https://www.kaggle.com/shohan06",
    icon: "KG",
  },
  {
    name: "LeetCode",
    description: "Algorithmic problem-solving practice",
    url: "https://leetcode.com/u/Shohan06/",
    icon: "LC",
  },
  {
    name: "Codeforces",
    description: "Competitive programming",
    url: "https://codeforces.com/profile/samael06",
    icon: "CF",
  },
];
---

<BaseLayout
  title="Contact | Data Science"
  description="Contact information and public academic, professional, and technical profiles."
>
  <div class="contact-page">
    <header class="contact-hero">
      <p class="eyebrow">CONTACT / CONNECTIONS</p>

      <h1>Let's connect and exchange ideas.</h1>

      <p class="hero-description">
        I'm interested in connecting with researchers, fellow data
        scientists, and people working on interesting technical problems.
        Feel free to reach out about research discussions, collaboration,
        or professional opportunities.
      </p>

      <a
        class="email-button"
        href={`mailto:${contactEmail}`}
      >
        <span class="email-icon" aria-hidden="true">@</span>
        <span>Get in touch</span>
        <span class="arrow" aria-hidden="true">↗</span>
      </a>

      <p class="email-address">{contactEmail}</p>
    </header>

    <section
      class="profile-section"
      aria-labelledby="academic-heading"
    >
      <div class="section-heading">
        <p class="eyebrow">01 / ACADEMIC & PROFESSIONAL</p>
        <h2 id="academic-heading">Academic and professional profiles</h2>
        <p class="section-description">
          Connect with me professionally or explore my research identity
          and scholarly record.
        </p>
      </div>

      <div class="profile-grid academic-grid">
        {academicProfiles.map((profile) => (
          <a
            class="profile-card"
            href={profile.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${profile.name}: ${profile.description} (opens in a new tab)`}
          >
            <span class="profile-icon" aria-hidden="true">
              {profile.icon}
            </span>

            <span class="profile-content">
              <span class="profile-name">{profile.name}</span>
              <span class="profile-description">
                {profile.description}
              </span>
            </span>

            <span class="profile-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>

    <section
      class="profile-section"
      aria-labelledby="technical-heading"
    >
      <div class="section-heading">
        <p class="eyebrow">02 / TECHNICAL & CODING</p>
        <h2 id="technical-heading">Explore my technical work</h2>
        <p class="section-description">
          Find my code, data science activities, and problem-solving practice
          across different platforms.
        </p>
      </div>

      <div class="profile-grid technical-grid">
        {technicalProfiles.map((profile) => (
          <a
            class="profile-card"
            href={profile.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${profile.name}: ${profile.description} (opens in a new tab)`}
          >
            <span class="profile-icon" aria-hidden="true">
              {profile.icon}
            </span>

            <span class="profile-content">
              <span class="profile-name">{profile.name}</span>
              <span class="profile-description">
                {profile.description}
              </span>
            </span>

            <span class="profile-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>

    <section class="closing-note" aria-label="Closing invitation">
      <p class="eyebrow">OPEN TO CONVERSATION</p>
      <h2>Good ideas grow through discussion.</h2>
      <p>
        Whether you have a research question, an interesting problem, or
        an opportunity to discuss, I'd be glad to hear from you.
      </p>
      <a class="text-link" href={`mailto:${contactEmail}`}>
        Write me an email <span aria-hidden="true">→</span>
      </a>
    </section>
  </div>
</BaseLayout>

<style>
  .contact-page {
    width: min(100% - 2.5rem, 1000px);
    margin-inline: auto;
    padding-block: 4rem 5rem;
    color: var(--color-text);
  }

  .contact-page * {
    box-sizing: border-box;
  }

  .contact-hero {
    max-width: 760px;
    margin-bottom: 5rem;
  }

  .eyebrow {
    margin: 0 0 1rem;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.09em;
    line-height: 1.6;
  }

  .contact-hero h1 {
    max-width: 720px;
    margin: 0;
    font-size: clamp(2.4rem, 6vw, 4.2rem);
    line-height: 1.1;
    letter-spacing: -0.055em;
    text-wrap: balance;
  }

  .hero-description {
    max-width: 680px;
    margin: 1.5rem 0 0;
    color: var(--color-text-muted);
    font-size: 1.08rem;
    line-height: 1.9;
  }

  .email-button {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    gap: 0.8rem;
    margin-top: 1.75rem;
    padding: 0.8rem 1.1rem;
    border: 1px solid var(--color-accent);
    border-radius: 6px;
    background: var(--color-accent);
    color: #282828;
    font-weight: 700;
    text-decoration: none;
    transition:
      background-color 150ms ease,
      border-color 150ms ease;
  }

  .email-button:hover {
    border-color: var(--color-accent-hover);
    background: var(--color-accent-hover);
  }

  .email-icon {
    font-family: var(--font-mono);
    font-size: 1.1rem;
  }

  .arrow {
    margin-left: 0.4rem;
  }

  .email-address {
    margin: 0.8rem 0 0;
    color: var(--color-text-subtle);
    font-family: var(--font-mono);
    font-size: 0.86rem;
    overflow-wrap: anywhere;
  }

  .profile-section {
    margin-top: 4.5rem;
  }

  .section-heading {
    max-width: 720px;
    margin-bottom: 1.5rem;
  }

  .section-heading h2,
  .closing-note h2 {
    margin: 0;
    font-size: clamp(1.65rem, 4vw, 2.3rem);
    line-height: 1.25;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .section-description {
    margin: 0.85rem 0 0;
    color: var(--color-text-muted);
    line-height: 1.8;
  }

  .profile-grid {
    display: grid;
    gap: 0.85rem;
  }

  .academic-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .technical-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .profile-card {
    display: flex;
    min-width: 0;
    min-height: 112px;
    align-items: flex-start;
    gap: 0.85rem;
    padding: 1.1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    color: var(--color-text);
    text-decoration: none;
    transition:
      border-color 150ms ease,
      background-color 150ms ease,
      transform 150ms ease;
  }

  .profile-card:hover {
    transform: translateY(-2px);
    border-color: var(--color-accent);
    background: var(--color-surface-raised);
  }

  .profile-icon {
    display: inline-flex;
    width: 40px;
    height: 40px;
    flex: 0 0 40px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-border);
    border-radius: 7px;
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .profile-content {
    display: flex;
    min-width: 0;
    flex: 1;
    flex-direction: column;
    gap: 0.4rem;
  }

  .profile-name {
    font-weight: 700;
    line-height: 1.4;
  }

  .profile-description {
    color: var(--color-text-muted);
    font-size: 0.86rem;
    line-height: 1.65;
    overflow-wrap: anywhere;
  }

  .profile-arrow {
    flex: 0 0 auto;
    color: var(--color-text-subtle);
  }

  .profile-card:hover .profile-arrow {
    color: var(--color-accent);
  }

  .closing-note {
    margin-top: 5rem;
    padding: clamp(1.4rem, 4vw, 2.5rem);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }

  .closing-note h2 {
    max-width: 650px;
  }

  .closing-note > p:not(.eyebrow) {
    max-width: 650px;
    margin: 1rem 0 1.25rem;
    color: var(--color-text-muted);
    line-height: 1.85;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--color-accent);
    font-weight: 700;
    text-decoration: none;
  }

  .text-link:hover {
    color: var(--color-accent-hover);
  }

  .profile-card:focus-visible,
  .email-button:focus-visible,
  .text-link:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 4px;
  }

  @media (max-width: 760px) {
    .contact-page {
      width: min(100% - 2rem, 1000px);
      padding-top: 2.5rem;
    }

    .academic-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .profile-section {
      margin-top: 3.5rem;
    }

    .contact-hero {
      margin-bottom: 3.5rem;
    }
  }

  @media (max-width: 520px) {
    .academic-grid,
    .technical-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .profile-card {
      min-height: 96px;
    }

    .closing-note {
      margin-top: 3.5rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .email-button,
    .profile-card {
      transition: none;
    }

    .profile-card:hover {
      transform: none;
    }
  }
</style>
