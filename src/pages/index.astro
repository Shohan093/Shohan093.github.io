---
import BaseLayout from "../layouts/BaseLayout.astro";

const skillGroups = [
  {
    title: "Programming Languages",
    skills: ["Python", "C/C++", "MATLAB", "FORTRAN", "HTML/CSS"],
  },
  {
    title: "Data Science & Statistics",
    skills: [
      "Pandas",
      "Scikit-learn",
      "Statsmodels",
      "Scipy",
      "Seaborn",
      "Plotly",
      "GeoPandas",
      "Statistical Data Analysis",
      "Time-Series Analysis",
      "Hypothesis Testing",
    ],
  },
  {
    title: "Machine Learning & AI",
    skills: [
      "PyTorch",
      "TensorFlow",
      "Hugging Face",
      "Generative AI",
      "LLM Fine-tuning",
      "Federated Learning",
    ],
  },
  {
    title: "LLM Inference & Retrieval",
    skills: [
      "NLTK",
      "Llama.cpp",
      "LangChain",
      "LangGraph",
      "LlamaIndex",
      "FAISS",
      "Vector Databases",
      "Distributed RAG",
    ],
  },
  {
    title: "Data Engineering & Cloud",
    skills: [
      "PySpark",
      "Apache Airflow",
      "BigQuery",
      "Google Cloud Platform",
      "MySQL",
      "PostgreSQL",
    ],
  },
  {
    title: "Systems & Developer Tools",
    skills: [
      "Linux",
      "Git",
      "GitHub",
      "Power BI",
      "Data Studio",
      "LaTeX",
      "Selenium",
      "Playwright",
      "Distributed Systems",
    ],
  },
];
---

<BaseLayout
  title="Home | Anisujjaman Shohan"
  description="Academic profile, technical skills, and interests in mathematics, data science, machine learning, and distributed systems."
>
  <main>
    <!-- Hero -->
    <section class="container section hero-section">
      <div class="reading-width">
        <p class="eyebrow">MATHEMATICS · STATISTICS · DATA SCIENCE</p>

        <h1 class="hero-title">
          Turning mathematical ideas into
          <span>meaningful insights.</span>
        </h1>

        <p class="hero-description">
          I'm a Data Science graduate student at BUET with a background in
          Mathematics and a curiosity about how data, algorithms, and
          statistical principles help us understand complex problems.
          I'm interested in machine learning, natural language processing,
          and distributed learning systems—and in the ideas that make them work.
        </p>

        <div class="hero-actions">
          <a class="button button-primary" href="/research/">
            Explore research <span aria-hidden="true">→</span>
          </a>

          <a
            class="button button-primary"
            href="/resume-anisujjaman.pdf"
            download="Shohan_Resume.pdf"
          >
            <span>Download CV</span>
            <svg
              aria-hidden="true"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
              <path d="m7 10 5 5 5-5" />
              <path d="M12 15V3" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Technical Stack -->
    <section
      class="container section skills-section"
      aria-labelledby="skills-heading"
    >
      <header class="skills-intro">
        <p class="eyebrow">TECHNICAL STACK</p>

        <h2 id="skills-heading" class="skills-title">
          Tools I work with.
        </h2>

        <p class="skills-description">
          Languages, libraries, and systems I use across data science,
          machine learning, natural language processing, and data-intensive
          computing.
        </p>
      </header>

      <div class="skills-grid">
        {skillGroups.map((group, index) => (
          <article class="skill-group">
            <div class="skill-group-heading">
              <span class="skill-index" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
              <h3>{group.title}</h3>
            </div>

            <ul class="skill-list" aria-label={group.title}>
              {group.skills.map((skill) => (
                <li class="skill-tag">{skill}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* Hero */
  .hero-title {
    max-width: 900px;
    margin: 0;
    font-size: clamp(2.5rem, 6vw, 4.75rem);
    font-weight: 700;
    line-height: 1.08;
    letter-spacing: -0.055em;
  }

  .hero-title span {
    display: block;
    margin-top: 0.25em;
    color: var(--color-accent);
  }

  .hero-description {
    max-width: 650px;
    margin-block: 1.75rem;
    color: var(--color-text-muted);
    font-size: clamp(1rem, 2vw, 1.15rem);
    line-height: 1.8;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  /* Buttons */
  .button {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    border: 1px solid var(--color-border);
    border-radius: 7px;
    padding: 0.65rem 1rem;
    font-size: 0.95rem;
    font-weight: 600;
    text-decoration: none;
    transition:
      background-color 150ms ease,
      border-color 150ms ease;
  }

  .button-primary {
    border-color: var(--color-accent);
    background: var(--color-accent);
    color: var(--color-bg);
  }

  .button-primary:hover {
    border-color: var(--color-accent-hover);
    background: var(--color-accent-hover);
    color: var(--color-bg);
  }

  .button-secondary {
    background: var(--color-surface);
    color: var(--color-text);
  }

  .button-secondary:hover {
    border-color: var(--color-secondary);
    color: var(--color-secondary);
  }

  /* Technical Stack */
  .skills-section {
    border-top: 1px solid var(--color-border);
  }

  .skills-intro {
    max-width: 680px;
    margin-bottom: 2.5rem;
  }

  .skills-title {
    margin: 0.4rem 0 0;
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 650;
    line-height: 1.2;
    letter-spacing: -0.035em;
  }

  .skills-description {
    max-width: 600px;
    margin-top: 0.9rem;
    color: var(--color-text-muted);
    line-height: 1.75;
  }

  .skills-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }

  .skill-group {
    min-width: 0;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    background: var(--color-surface);
  }

  .skill-group-heading {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    margin-bottom: 1.1rem;
  }

  .skill-index {
    flex-shrink: 0;
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 650;
    font-variant-numeric: tabular-nums;
  }

  .skill-group h3 {
    margin: 0;
    font-size: 1.05rem;
    font-weight: 650;
    line-height: 1.45;
  }

  .skill-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .skill-tag {
    border: 1px solid var(--color-border);
    border-radius: 5px;
    padding: 0.35rem 0.6rem;
    color: var(--color-text-muted);
    font-size: 0.85rem;
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  /* Responsive layout */
  @media (max-width: 640px) {
    .skills-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 1rem;
    }

    .skill-group {
      padding: 1.2rem;
    }
  }

  /* Accessibility */
  @media (prefers-reduced-motion: reduce) {
    .button {
      transition: none;
    }
  }
</style>